# Frontend Environment Variables

# PostgreSQL Database URL 
# If using Docker Compose: user and password are set in the root .env file
# If running locally, copy and paste the URLs given from `npx prisma dev`
DATABASE_URL="postgresql://postgres:password@localhost:5432/dawgdecision?sslmode=disable"
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/dawgdecision_shadow?sslmode=disable"

# Secret key for BetterAuth (DO NOT USE THIS IN PRODUCTION, GENERATE A NEW ONE)
BETTER_AUTH_SECRET=gQhKH1VDXWvprDPaZB0u3yDGbPDhSCLh

# Base URL of app for BetterAuth
BETTER_AUTH_URL=http://localhost:3000

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
